APP_NAME=Weather Service
APP_ENV=production
DEBUG=false

OPENWEATHERMAP_API_KEY=b12505dfa3865989452161d336d8ee5c
DEFAULT_USER_LOCATION=55.755826,37.617299

HTTP_TIMEOUT=5
CACHE_TTL_SECONDS=900
CACHE_URL=redis://127.0.0.1:6379/0
