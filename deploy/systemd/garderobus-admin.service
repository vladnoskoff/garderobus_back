[Unit]
Description=Garderobus Admin API
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=garderobus
Group=garderobus
WorkingDirectory=/home/garderobus/garderobus_back/api
EnvironmentFile=-/etc/garderobus/admin-api.env
ExecStart=/usr/bin/env uvicorn admin_main:app --host 0.0.0.0 --port 8100 --workers 2
Restart=always
RestartSec=5s
TimeoutStartSec=60
KillMode=mixed

# Logging
StandardOutput=append:/var/log/garderobus/admin-api.log
StandardError=append:/var/log/garderobus/admin-api.log

[Install]
WantedBy=multi-user.target
