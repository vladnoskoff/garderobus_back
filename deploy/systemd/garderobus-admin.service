[Unit]
Description=Garderobus Admin API
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/garderobus/garderobus_back
EnvironmentFile=-/etc/garderobus/admin-api.env
Environment="PATH=/home/garderobus/garderobus_back/.venv-admin/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
ExecStart=/home/garderobus/garderobus_back/.venv-admin/bin/uvicorn api_admin.main:app --host 0.0.0.0 --port 8100 --workers 2
Restart=always
RestartSec=5s
TimeoutStartSec=60
KillMode=mixed

# Logging
StandardOutput=append:/var/log/garderobus/admin-api.log
StandardError=append:/var/log/garderobus/admin-api.log

[Install]
WantedBy=multi-user.target
